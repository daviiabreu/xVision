# Chave da Roboflow, usada pelos scripts de treino em `src/models`.
ROBOFLOW_API_KEY=

# Segredo de assinatura das sessões do serviço HTTP. Sem ele o serviço não sobe, de propósito:
# segredo padrão é pior que segredo ausente, porque funciona e ninguém repara.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
XVISION_AUTH_SECRET=

# Token de serviço semeado na subida, para integração máquina a máquina. Vazio desliga a semeadura.
XVISION_API_TOKEN=

# Origens que o navegador pode usar para chamar a API, separadas por vírgula.
# Padrão: http://localhost:5173,http://localhost:3000
XVISION_CORS_ORIGINS=

# Intervalo sugerido pela API para a próxima consulta de progresso, em segundos. Padrão: 2.
XVISION_STATUS_RETRY_S=

# Tempo máximo, em segundos, entre reservar um upload e iniciar o PUT. Padrão: 900.
XVISION_UPLOAD_RESERVATION_TTL_S=

# Recuperacao de senha por email. Sem host, remetente e URL publica, a rota responde 503 em vez
# de fingir que enviou uma mensagem. STARTTLS usa 1 por padrao; use 0 somente num SMTP local.
XVISION_PUBLIC_URL=http://localhost:3000
XVISION_SMTP_HOST=
XVISION_SMTP_PORT=587
XVISION_SMTP_USER=
XVISION_SMTP_PASSWORD=
XVISION_SMTP_FROM=
XVISION_SMTP_STARTTLS=1
XVISION_PASSWORD_RESET_TTL_S=1800

# Caixa de email local com `docker compose -f compose.yaml -f compose.mailpit.yaml up --build --wait`.
# Esse arquivo configura o SMTP da API automaticamente. Porta do Mailpit no localhost: 8025.
XVISION_MAILPIT_PORT=

# Qual arquivo de `config/` o serviço roda. Padrão: pipeline.toml, que declara as sete espécies
# como stub e por isso responde sem medir nada.
XVISION_PIPELINE=

# Endereço da API assado no build do frontend. Vazio usa a mesma origem e o proxy do Nginx.
VITE_API_URL=

# Porta pública do produto. A API fica disponível na mesma origem, sob `/v1`.
XVISION_FRONTEND_PORT=
