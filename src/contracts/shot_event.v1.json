{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xvision.inteli.edu.br/schema/shot_event.v1.json",
  "title": "ShotEvent",
  "description": "Evento de finalizacao que atravessa a fronteira entre a borda e a nuvem.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "shot_id",
    "clip_id",
    "match_id",
    "shot_timestamp_s",
    "features",
    "pipeline"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "shot_id": {
      "type": "string",
      "minLength": 1,
      "description": "Chave de idempotencia, formada por clip_id e o quadro do contato.",
      "pattern": "^.+:[0-9]+$"
    },
    "clip_id": {
      "type": "string",
      "minLength": 1
    },
    "match_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Chave de particao. Nulo quando o clipe chega sem partida associada."
    },
    "shot_timestamp_s": {
      "type": "number",
      "minimum": 0
    },
    "features": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/featureValue"
      }
    },
    "pipeline": {
      "$ref": "#/$defs/pipelineMetadata"
    }
  },
  "$defs": {
    "featureValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "status",
        "value",
        "confidence",
        "reason",
        "evidence"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "ok",
            "low_confidence",
            "unavailable"
          ]
        },
        "value": {
          "type": [
            "number",
            "string",
            "boolean",
            "null"
          ]
        },
        "confidence": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence": {
          "type": "object"
        }
      },
      "if": {
        "not": {
          "properties": {
            "status": {
              "const": "ok"
            }
          },
          "required": [
            "status"
          ]
        }
      },
      "then": {
        "properties": {
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "pipelineMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "versions",
        "timings_ms",
        "host",
        "started_at"
      ],
      "properties": {
        "versions": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "nome@versao de cada modulo que rodou."
        },
        "timings_ms": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        },
        "host": {
          "type": "string",
          "minLength": 1
        },
        "started_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^([0-9]{4}-[0-9]{2}-[0-9]{2})T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?(?:Z|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])$",
          "description": "Perfil estreito de RFC 3339: T e Z maiusculos, segundo de 00 a 59, digito ASCII. O pattern repete o format porque format e anotacao no draft 2020-12, nao assercao."
        }
      }
    }
  }
}
