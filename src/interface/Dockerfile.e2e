FROM mcr.microsoft.com/playwright:v1.62.1-noble

WORKDIR /work

COPY package.json package-lock.json ./
RUN npm ci --no-audit --fund=false

COPY playwright.config.ts ./

RUN apt-get update \
 && apt-get install -y --no-install-recommends ffmpeg \
 && mkdir -p /fixtures \
 && ffmpeg -hide_banner -loglevel error -f lavfi -i color=c=green:s=320x240:d=3:r=10 \
      -c:v libx264 -pix_fmt yuv420p /fixtures/resultado.mp4 \
 && rm -rf /var/lib/apt/lists/*

COPY e2e ./e2e

ENV E2E_BASE_URL=http://frontend:3000 \
    E2E_VIDEO_PATH=/fixtures/resultado.mp4

CMD ["npm", "run", "test:e2e"]
