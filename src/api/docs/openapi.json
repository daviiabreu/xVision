  "components": {
    "schemas": {
      "Aceito": {
        "properties": {
          "status": {
            "type": "integer",
            "title": "Status",
            "description": "Codigo HTTP repetido no corpo, como o contrato pede."
          },
          "id": {
            "type": "integer",
            "title": "Id",
            "description": "Identificador do video para consultar o andamento."
          }
        },
        "type": "object",
        "required": [
          "status",
          "id"
        ],
        "title": "Aceito",
        "description": "A resposta de quem so enfileirou: o trabalho comeca depois que esta resposta ja saiu."
      },
      "Erro": {
        "properties": {
          "detail": {
            "type": "string",
            "title": "Detail"
          }
        },
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "Erro",
        "description": "A forma de toda recusa, para quem gera cliente a partir do contrato nao errar o tipo."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LoginRequest": {
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "title": "Email"
          },
          "senha": {
            "type": "string",
            "maxLength": 256,
            "title": "Senha"
          }
        },
        "type": "object",
        "required": [
          "email",
          "senha"
        ],
        "title": "LoginRequest"
      },
      "Metrica": {
        "properties": {
          "nome": {
            "type": "string",
            "title": "Nome"
          },
          "unidade_de_medida": {
            "type": "string",
            "title": "Unidade De Medida"
          },
          "tipo": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "boolean",
                  "float",
                  "text"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Tipo",
            "description": "Tipo do valor medido. Nulo quando nao houve leitura, porque ele sai do valor."
          },
          "valor": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "number"
              },
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Valor",
            "description": "Nulo quando a feature nao pode ser medida."
          },
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "low_confidence",
              "unavailable"
            ],
            "title": "Status",
            "description": "Numero medido e numero indisponivel nao tem a mesma cara.",
            "default": "ok"
          }
        },
        "type": "object",
        "required": [
          "nome",
          "unidade_de_medida"
        ],
        "title": "Metrica"
      },
      "PrincipalResponse": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "tipo": {
            "type": "string",
            "enum": [
              "usuario",
              "servico"
            ],
            "title": "Tipo"
          },
          "nome": {
            "type": "string",
            "title": "Nome"
          }
        },
        "type": "object",
        "required": [
          "id",
          "tipo",
          "nome"
        ],
        "title": "PrincipalResponse"
      },
      "ProcessamentoRequest": {
        "properties": {
          "file": {
            "type": "string",
            "title": "File",
            "description": "O video inteiro, em base64."
          },
          "contentType": {
            "type": "string",
            "maxLength": 255,
            "title": "Contenttype",
            "description": "Tipo do arquivo enviado. Aceita os nomes contentType e type."
          },
          "fileName": {
            "type": "string",
            "maxLength": 255,
            "title": "Filename",
            "description": "Nome original, so para registro.",
            "default": "upload.mp4"
          }
        },
        "type": "object",
        "required": [
          "file",
          "contentType"
        ],
        "title": "ProcessamentoRequest",
        "description": "O caminho base64, que existe para atender o contrato escrito.\n\nEle carrega o video inteiro dentro de um campo de texto, e base64 infla 33%: um clipe de\n16 MB vira 22 MB de JSON que o servidor precisa manter em memoria antes de decodificar. Por\nisso ele tem teto proprio e o caminho recomendado e o `PUT` da URL de envio, que transmite o\nbinario direto para o disco."
      },
      "RegistroRequest": {
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "title": "Email",
            "description": "Serve de identificador da conta."
          },
          "senha": {
            "type": "string",
            "maxLength": 256,
            "minLength": 12,
            "title": "Senha"
          }
        },
        "type": "object",
        "required": [
          "email",
          "senha"
        ],
        "title": "RegistroRequest",
        "description": "Comprimento minimo, e nenhuma regra de simbolo obrigatorio.\n\nExigir maiuscula, numero e simbolo produz `Senha@123` e nada mais: as pessoas satisfazem a\nregra pelo caminho mais curto, que e o mesmo caminho para todo mundo, e o conjunto de senhas\nprovaveis encolhe. Comprimento e o unico parametro que aumenta o custo de adivinhar sem\nempurrar todo mundo para o mesmo padrao."
      },
